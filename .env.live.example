# Copy to .env.live and fill with LIVE Stripe keys only (never commit .env.live).
# Stripe Dashboard → Live mode → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe-only go-live (Paystack paused)
STRIPE_ONLY=true
PAYSTACK_ENABLED=false
BILLING_PROVIDER=stripe

# Production backend public URL (used for Stripe webhook creation)
BACKEND_PUBLIC_URL=https://convertide-backend-dev.onrender.com
