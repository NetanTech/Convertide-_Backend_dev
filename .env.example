PORT=4210
NODE_ENV=development

# Frontend origins allowed to call this API (comma-separate: local + staging + live)
FRONTEND_URL=http://localhost:3000,http://localhost:3001,https://stagging.converttide.com

# Public app URL for links in emails — set per deploy environment:
# Local:   http://localhost:3000
# Staging: https://stagging.converttide.com
# Live:    https://converttide.com
APP_PUBLIC_URL=https://stagging.converttide.com

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio -> Get API key (https://aistudio.google.com/apikey) - free, no card required
GEMINI_API_KEY=

# Product emails — ZeptoMail HTTP API (not SMTP)
# From your Mail Agent: SMTP/API → API → Send Mail / Send API token
# Authorization header uses: Zoho-enczapikey <token>
EMAIL_FROM=noreply@stagging.converttide.com
EMAIL_FROM_NAME=Converttide
ZEPTOMAIL_API_KEY=
# Optional EU/IN endpoint override, e.g. https://api.zeptomail.eu/v1.1/email
# ZEPTOMAIL_API_URL=

# Stripe (Billing) — leave blank to keep mock plan switching in local dev
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs from Stripe Products (Pro $149 / Scale $499 monthly)
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
# Optional one-time price for credit add-on packs
STRIPE_PRICE_CREDITS_ADDON=

# Social integrations (OAuth). Leave blank until each app is created.
# Set INTEGRATIONS_DEMO_MODE=true to allow Connect without real OAuth (local/dev).
INTEGRATIONS_DEMO_MODE=true
INTEGRATIONS_STATE_SECRET=
BACKEND_PUBLIC_URL=http://localhost:4210
# Meta (Facebook + Instagram)
META_APP_ID=
META_APP_SECRET=
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Help & Support — inbox gets chat/contact emails; booking URL for "Book a call"
SUPPORT_INBOX=support@converttide.com
SUPPORT_PUBLIC_EMAIL=support@converttide.com
# e.g. https://calendly.com/your-team/intro
SUPPORT_BOOKING_URL=
