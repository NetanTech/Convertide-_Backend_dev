PORT=4210
NODE_ENV=development

# Frontend origins allowed to call this API (comma-separate: local + staging + live)
FRONTEND_URL=http://localhost:3000,http://localhost:3001,https://stagging.converttide.com

# Public app URL for links in emails — set per deploy environment:
# Local:   http://localhost:3000
# Staging: https://stagging.converttide.com
# Live:    https://converttide.com
APP_PUBLIC_URL=https://stagging.converttide.com

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio -> Get API key (https://aistudio.google.com/apikey) - free, no card required
GEMINI_API_KEY=
# Anthropic Claude -> used for paid tiers (Pro / Scale)
ANTHROPIC_API_KEY=
# Optional: override Claude model by paid tier
CLAUDE_PRO_MODEL=claude-3-5-sonnet-latest
CLAUDE_SCALE_MODEL=claude-3-5-sonnet-latest

# Product emails — ZeptoMail HTTP API (not SMTP)
# From your Mail Agent: SMTP/API → API → Send Mail / Send API token
# Authorization header uses: Zoho-enczapikey <token>
EMAIL_FROM=noreply@stagging.converttide.com
EMAIL_FROM_NAME=Converttide
ZEPTOMAIL_API_KEY=
# Optional EU/IN endpoint override, e.g. https://api.zeptomail.eu/v1.1/email
# ZEPTOMAIL_API_URL=

# Billing provider: auto | stripe | paystack
# auto = abroad → Stripe; Nigeria → Paystack default, both offered when both configured
BILLING_PROVIDER=auto

# Stripe (international USD) — Dashboard: https://dashboard.stripe.com/apikeys
# Use Test mode keys until go-live. Create Products → Prices for Pro ($49) and Scale ($79).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Alias kept for older env files
STRIPE_PRICE_SCALE=
# Credit add-on: either a Price ID, or amount in cents (e.g. 2900 = $29.00)
STRIPE_CREDITS_ADDON_PRICE_ID=
STRIPE_CREDITS_ADDON_AMOUNT_CENTS=
# Webhook URL: {BACKEND_PUBLIC_URL}/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.*, invoice.paid, invoice.payment_failed

# Paystack (Nigeria / NGN) — leave blank to keep mock plan switching in local dev
# Dashboard: https://dashboard.paystack.com/#/settings/developer
# Toggle Test mode in the dashboard. Webhook: {BACKEND_PUBLIC_URL}/api/billing/webhook
PAYSTACK_SECRET_KEY=
# Optional public key if you later embed Paystack Inline on the frontend
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=NGN
# Plan codes from Paystack Dashboard → Plans (monthly Pro / Enterprise)
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_ENTERPRISE=
# Alias kept for older env files
PAYSTACK_PLAN_SCALE=
# One-time credit pack amount in kobo (e.g. 2900000 = ₦29,000.00)
PAYSTACK_CREDITS_ADDON_AMOUNT_KOBO=

# Social integrations (OAuth). Leave blank until each app is created.
# Set INTEGRATIONS_DEMO_MODE=true to allow Connect without real OAuth (local/dev).
INTEGRATIONS_DEMO_MODE=true
INTEGRATIONS_STATE_SECRET=
BACKEND_PUBLIC_URL=http://localhost:4210
# Meta (Facebook + Instagram)
META_APP_ID=
META_APP_SECRET=
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Help & Support — inbox gets chat/contact emails; booking URL for "Book a call"
SUPPORT_INBOX=support@converttide.com
SUPPORT_PUBLIC_EMAIL=support@converttide.com
# e.g. https://calendly.com/your-team/intro
SUPPORT_BOOKING_URL=
